# Copy to .env and fill in. Never commit the real file.

# Satellite AI sweeper (scripts/ai_background_sweeper.py): Mapbox satellite imagery.
MAPBOX_ACCESS_TOKEN=

# Backend (FastAPI)
MANARA_DATABASE_URL=postgresql://manara:change-me@localhost:5432/manara
# Comma-separated numeric OSM user ids with admin rights / access to the suggestions layer.
MANARA_ADMIN_UIDS=
MANARA_SUGGESTIONS_ALLOWLIST=
# Local development only: also accepts OSM dev-server logins and plain-HTTP session cookies.
# Leave unset in production.
# MANARA_DEV_MODE=1

# scripts/publish_ai_detections.py: where the API container runs.
# MANARA_VPS=user@your-server
# MANARA_API_CONTAINER=
