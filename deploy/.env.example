# Copy to deploy/.env on the VPS (never commit the real file) and fill in.
# Generate each secret with:  openssl rand -hex 32

# PostgreSQL superuser for Manara's database.
POSTGRES_PASSWORD=

# Umami's own database role (created by initdb/01-umami.sh on first start).
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Must be 64 hex characters (openssl rand -hex 32 gives exactly that).
UMAMI_TWO_FACTOR_KEY=

# Website ID from Manara's Umami dashboard (analytics.saudiosm.org ->
# Settings -> Websites -> Add website). Baked into the frontend build by
# deploy/deploy.sh; leave empty to build without analytics.
VITE_UMAMI_WEBSITE_ID=
