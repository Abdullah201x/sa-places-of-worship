:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://server.arcgisonline.com https://*.basemaps.cartocdn.com; font-src 'self'; connect-src 'self' https://api.openstreetmap.org https://www.openstreetmap.org https://master.apis.dev.openstreetmap.org https://server.arcgisonline.com http://127.0.0.1:8111; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Datasets: file?v=<timestamp> is cached permanently, summary.json revalidates
	handle /data/* {
		root * /srv/manara
		@geojson path *.geojson
		header @geojson Content-Type "application/geo+json; charset=utf-8"
		@versioned query v=*
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		@unversioned not query v=*
		header @unversioned Cache-Control "no-cache"
		file_server
	}

	# Frontend: Hashed assets cached permanently, HTML pages revalidate
	handle {
		root * /srv/manara/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} {path}.html
		file_server
	}
}
